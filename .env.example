# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Provedor de IA — "openai" | "anthropic" | "none"
# NEXT_PUBLIC_ para o frontend saber se IA está ativa
NEXT_PUBLIC_AI_PROVIDER=none

# Chaves secretas (apenas servidor — nunca exponha no frontend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Usar o mesmo valor que NEXT_PUBLIC_AI_PROVIDER
AI_PROVIDER=none
